# ==============================================================================
# 🤖 TELEGRAM BOT CONFIGURATION
# ==============================================================================
TELEGRAM_API_TOKEN=your_telegram_bot_token_here
ADMIN_USER_ID=your_telegram_user_id_numeric

# ==============================================================================
# 📊 MARKET DATA & ON-CHAIN API KEYS
# ==============================================================================
# CoinGecko API Key (Demo keys start with CG-, Pro keys without)
COINGECKO_API_KEY=your_coingecko_api_key

# Quant Signals API (signals.x70.ai - Optional, works with public endpoints too)
X70_SIGNALS_API_KEY=
X70_SIGNALS_BASE_URL=https://signals.x70.ai

# Whale Alert API Key (Optional)
WHALE_ALERT_API_KEY=

# ==============================================================================
# 🧠 AI ENGINE (OPENROUTER & GOOGLE GEMINI FALLBACK)
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Google Gemini API (Optional fallback & grounded web search)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_ASK=gemini-2.0-flash
GEMINI_ASK_PERSONA=analyst
GEMINI_ASK_STYLE=natural
GEMINI_ASK_TEMPERATURE=0.6

# ==============================================================================
# 📡 TELETHON USERBOT (OPTIONAL - FOR MARKETFEED CHANNEL AGGREGATION)
# ==============================================================================
TELETHON_ENABLED=0
TELETHON_API_ID=0
TELETHON_API_HASH=
TELETHON_SESSION_NAME=userbot
TELETHON_CHANNELS=marketfeed
TELETHON_FETCH_LIMIT=50
TELETHON_POLL_SEC=120

# ==============================================================================
# 🎓 PUMP.FUN ➔ RAYDIUM GRADUATION RADAR
# ==============================================================================
ALPHA_CHANNEL=@your_channel_username
ALPHA_SCANNER_ENABLED=1
